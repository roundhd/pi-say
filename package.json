{
  "name": "pi-say",
  "version": "0.1.0",
  "description": "Text to speech for pi using macOS `say`. Bilingual EN/ZH, no server, no downloads.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "author": "Shiyuan Zheng",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "tts",
    "macos",
    "say",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/roundhd/pi-say"
  },
  "files": [
    "extensions",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "node --import jiti/register --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^26.2.0",
    "jiti": "^2.4.2",
    "typebox": "^1.3.7",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
